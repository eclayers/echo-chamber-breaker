# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Storage Provider: 'local' (file-backed JSON) or 'dynamodb'
STORAGE_PROVIDER=local
STORAGE_FILE_PATH=./data/honesty_ledger.json

# Amazon Bedrock Configuration (Optional for mock mode; required for live cloud calls)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Model Selection: 'anthropic.claude-3-5-sonnet-20241022-v2:0' or 'amazon.nova-pro-v1:0' or 'mock'
BEDROCK_MODEL_ID=mock
